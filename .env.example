# PostgreSQL (Supabase / Neon / local)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DIRECT_URL="postgresql://user:password@host:port/database?schema=public"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (redirect URI: <NEXTAUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Operators who can manage /admin (comma separated e-mails)
ADMIN_EMAILS="you@example.com"

# fal.ai — leave empty to run in mock mode (sample clip, no charges)
FAL_KEY=""
# Public base URL fal.ai posts webhooks to (usually = NEXTAUTH_URL)
WEBHOOK_URL="http://localhost:3000"

# Payments — pick one provider. Creem (creem.io) is a merchant of record that accepts individual
# sellers from mainland China; Stripe needs a Stripe-supported country.
PAYMENT_PROVIDERS="paypal,creem"   # buttons shown on /pricing, in this order

# PayPal (REST Orders v2). Sandbox creds from developer.paypal.com → Apps & Credentials.
# Live credentials require a PayPal Business account.
PAYPAL_ENV="sandbox"             # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""             # after creating a webhook for PAYMENT.CAPTURE.COMPLETED → /api/webhook/paypal
CREEM_API_KEY=""                 # creem_test_… → test-api.creem.io, creem_live_… → api.creem.io
CREEM_WEBHOOK_SECRET=""          # Developers → Webhooks → https://h3max.info/api/webhook/creem
CREEM_PRODUCT_STARTER=""         # one Creem product per credit pack (prod_…)
CREEM_PRODUCT_CREATOR=""
CREEM_PRODUCT_PRO=""
CREEM_PRODUCT_STUDIO=""

# Stripe (only if PAYMENT_PROVIDER=stripe)
# Stripe Checkout (credit packs)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
